# File Integrity Monitor
FIM_MONITOR_PATH=/absolute/path/to/protected/directory
FIM_STATE_DIR=.fim-state
FIM_INTERVAL_SECONDS=60

# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FIM_INTEGRITY_KEY=replace-with-at-least-32-random-bytes-as-hex

# Comma-separated glob patterns relative to FIM_MONITOR_PATH.
FIM_EXCLUDE_PATTERNS=*.tmp,*.swp

# Jira Cloud incident delivery
JIRA_ENABLED=true
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Task
JIRA_TIMEOUT_SECONDS=10
JIRA_MAX_ATTEMPTS=5
